PORT=3000

# Prisma SQLite database
DATABASE_URL="file:./data/dev.db"

# JWT secret (change in production)
JWT_SECRET="replace_with_a_long_random_secret"
JWT_EXPIRES_IN="24h"

# CORS allowed origins (comma-separated). Empty = allow all (dev only)
# CORS_ORIGINS=http://localhost:5173,https://your-domain.com

# Local backup folder name (under backend/)
BACKUP_DIR="backup"

# 备份保留份数。0 表示不清理；默认 30。
# BACKUP_RETENTION_COUNT=30

# Excel 导入单文件上限（MB）。默认 20；设为 0 不限制（注意内存）
# EXCEL_IMPORT_MAX_MB=20

# 反代/网关后真实客户端 IP 识别。可选值：true / false / loopback / linklocal / uniquelocal / 数字（信任跳数）/ IP CIDR。默认 loopback。
# TRUST_PROXY=loopback

# Prisma 慢查询阈值（毫秒）。仅 NODE_ENV != production 时生效；0 表示关闭。默认 200。
# SLOW_QUERY_MS=200

# 日志级别：debug / info / warn / error。默认开发环境 debug，生产 info。
# LOG_LEVEL=info
