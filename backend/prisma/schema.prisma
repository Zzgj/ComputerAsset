generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "sqlite"
}

enum DeviceType {
  laptop
  desktop
  aio
  server
  other
}

enum AssetStatus {
  in_stock
  waiting_pickup
  pending_confirmation
  in_use
  borrowed
  in_repair
  retired
}

enum AssetRecordAction {
  stock_in
  assign
  cancel_assign
  pick_up
  check_out
  lend
  return
  transfer
  repair
  repair_done
  retire
  manual_note
  signature_reset
}

enum RepairResult {
  fixed
  unfixable
}

enum EmployeeStatus {
  active
  resigned
}

enum EmployeeResourceType {
  phone_sim
  email
  domain_account
  badge
  access_card
  seat
  other
}

enum EmployeeResourceStatus {
  active
  closed
}

model User {
  id               Int              @id @default(autoincrement())
  username         String           @unique
  password         String
  realName         String
  accessRoleId     Int
  accessRole       AccessRole       @relation(fields: [accessRoleId], references: [id])
  isActive         Boolean          @default(true)
  mustChangePass   Boolean          @default(false)
  sessionToken     String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  operatorLogs     OperationLog[]  @relation("OperatorLogs")
  assetRecords     AssetRecord[]   @relation("RecordOperator")
  sentNotifications AssetTransferNotification[] @relation("TransferNotificationSender")
  receivedNotifications AssetTransferNotification[] @relation("TransferNotificationRecipient")

  @@index([username])
  @@index([accessRoleId])
}

/** 可配置访问角色：用户通过 accessRoleId 绑定；超级管理员 bypassAll 跳过权限与园区校验 */
model AccessRole {
  id          Int      @id @default(autoincrement())
  name        String
  slug        String   @unique
  description String?
  isSystem    Boolean  @default(false)
  bypassAll   Boolean  @default(false)
  campusesAll Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  permissions AccessRolePermission[]
  campuses    AccessRoleCampus[]
  users       User[]
}

model AccessRolePermission {
  id     Int        @id @default(autoincrement())
  roleId Int
  role   AccessRole @relation(fields: [roleId], references: [id], onDelete: Cascade)
  key    String

  @@unique([roleId, key])
  @@index([roleId])
}

model AccessRoleCampus {
  id       Int        @id @default(autoincrement())
  roleId   Int
  role     AccessRole @relation(fields: [roleId], references: [id], onDelete: Cascade)
  campusId Int
  campus   Campus     @relation(fields: [campusId], references: [id], onDelete: Cascade)

  @@unique([roleId, campusId])
  @@index([roleId])
}

model Campus {
  id           Int           @id @default(autoincrement())
  name         String        @unique
  sortOrder    Int
  isActive     Boolean       @default(true)
  departments  Department[]
  employees    Employee[]
  roleCampuses AccessRoleCampus[]
  sentTransferNotifications AssetTransferNotification[] @relation("TransferNotificationFromCampus")
  receivedTransferNotifications AssetTransferNotification[] @relation("TransferNotificationToCampus")
}

model Department {
  id          Int           @id @default(autoincrement())
  campusId    Int
  campus      Campus        @relation(fields: [campusId], references: [id])
  parentId    Int?
  parent      Department?   @relation("DepartmentHierarchy", fields: [parentId], references: [id])
  children    Department[]  @relation("DepartmentHierarchy")

  name        String
  sortOrder   Int
  isActive    Boolean       @default(true)

  assets      Asset[]
  records     AssetRecord[]
  employees   Employee[]

  @@index([campusId, parentId])
  @@index([sortOrder])
}

model AssetTemplate {
  id          Int         @id @default(autoincrement())
  name        String      @unique
  deviceType  String
  brand       String
  model       String
  os          String
  cpu         String
  memory      String
  storage     String
  remark      String?
  isActive    Boolean     @default(true)
  sortOrder   Int

  assets      Asset[]
}

model Asset {
  id                Int              @id @default(autoincrement())
  assetCode         String           @unique
  templateId        Int?
  template          AssetTemplate?  @relation(fields: [templateId], references: [id])

  deviceType        String
  brand             String
  model             String
  serialNumber      String          @unique
  os                String
  cpu               String
  memory            String
  storage           String

  status            AssetStatus
  currentUserName  String
  currentEmployeeId Int?
  currentEmployee   Employee?      @relation(fields: [currentEmployeeId], references: [id])
  departmentId      Int
  department        Department      @relation(fields: [departmentId], references: [id])

  purchaseDate      DateTime
  warrantyExpiry    DateTime?
  remark            String?
  version           Int              @default(1)

  records           AssetRecord[]
  repairRecords    RepairRecord[]
  transferNotifications AssetTransferNotification[]

  @@index([status])
  @@index([deviceType])
  @@index([currentUserName])
  @@index([currentEmployeeId])
  @@index([departmentId, status])
}

model AssetRecord {
  id                    Int                 @id @default(autoincrement())
  assetId               Int
  asset                 Asset               @relation(fields: [assetId], references: [id])

  action                AssetRecordAction
  userName              String
  employeeId            Int?
  employee              Employee?           @relation(fields: [employeeId], references: [id])
  departmentId          Int
  department            Department         @relation(fields: [departmentId], references: [id])
  actionDate            DateTime
  expectedReturnDate   DateTime?
  proofImage            String?
  remark                String?

  operatorId            Int
  operator              User                @relation(fields: [operatorId], references: [id], name: "RecordOperator")

  requestId            String             @unique
  createdAt            DateTime           @default(now())
  transferNotifications AssetTransferNotification[]

  @@index([assetId, createdAt])
  @@index([userName])
  @@index([employeeId])
}

model AssetTransferNotification {
  id              Int          @id @default(autoincrement())
  assetId         Int
  asset           Asset        @relation(fields: [assetId], references: [id], onDelete: Cascade)
  recordId        Int
  record          AssetRecord  @relation(fields: [recordId], references: [id], onDelete: Cascade)

  fromCampusId    Int
  fromCampus      Campus       @relation("TransferNotificationFromCampus", fields: [fromCampusId], references: [id])
  toCampusId      Int
  toCampus        Campus       @relation("TransferNotificationToCampus", fields: [toCampusId], references: [id])

  senderId        Int
  sender          User         @relation("TransferNotificationSender", fields: [senderId], references: [id])
  recipientId     Int
  recipient        User        @relation("TransferNotificationRecipient", fields: [recipientId], references: [id])

  message         String
  isRead          Boolean      @default(false)
  readAt          DateTime?
  createdAt       DateTime     @default(now())

  @@unique([recordId, recipientId])
  @@index([recipientId, isRead, createdAt])
  @@index([senderId, createdAt])
  @@index([assetId])
  @@index([fromCampusId, toCampusId])
}

model RepairRecord {
  id              Int           @id @default(autoincrement())
  assetId         Int
  asset           Asset         @relation(fields: [assetId], references: [id])

  faultDescription String
  repairVendor     String
  repairCost       Float
  repairResult     RepairResult
  startDate        DateTime
  endDate          DateTime
  remark           String?
}

model SystemConfig {
  configKey     String   @id
  configValue   String
  description   String?
  updatedAt     DateTime @updatedAt
  createdAt     DateTime @default(now())
}

model OperationLog {
  id           Int      @id @default(autoincrement())
  operatorId   Int
  operator     User     @relation(fields: [operatorId], references: [id], name: "OperatorLogs")

  action       String
  targetType   String
  targetId     Int
  detail       Json
  ipAddress    String
  createdAt    DateTime @default(now())
}

model Employee {
  id            Int             @id @default(autoincrement())
  employeeNo    String          @unique
  name          String
  campusId      Int
  campus        Campus          @relation(fields: [campusId], references: [id])
  departmentId  Int?
  department    Department?     @relation(fields: [departmentId], references: [id])

  status        EmployeeStatus  @default(active)
  joinedAt      DateTime?
  resignedAt    DateTime?
  remark        String?

  resources     EmployeeResource[]
  assets        Asset[]
  records       AssetRecord[]

  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([campusId, status])
  @@index([departmentId])
  @@index([name])
}

model EmployeeResource {
  id            Int                    @id @default(autoincrement())
  employeeId    Int
  employee      Employee               @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  type          EmployeeResourceType
  identifier    String
  status        EmployeeResourceStatus @default(active)
  assignedAt    DateTime               @default(now())
  closedAt      DateTime?
  remark        String?

  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  @@index([employeeId, status])
  @@index([type, identifier])
}
